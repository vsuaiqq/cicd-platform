# Quick start:  make start
# Help:         make help
# Re-seed Vault after .env change:  make vault-seed

# --- Vault (docker) ---
VAULT_DEV_ROOT_TOKEN=dev-root-token

# --- Platform secrets (seeded into Vault by vault-init) ---
POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpass
POSTGRES_DB=authdb

JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars
REDIS_PASSWORD=

PROJECTS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.dev/webhook/github

ORCHESTRATOR_INTERNAL_API_KEY=dev-orchestrator-internal-key-change-in-prod

AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
AI_LLM_MODEL=GigaChat

CLICKHOUSE_PASSWORD=analytics
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Local go run (uncomment overrides; docker hostnames are YAML defaults) ---
# REDIS_ADDR=localhost:6379
# KAFKA_BROKERS=localhost:9092
# AUTH_SERVICE_GRPC_ADDRESS=localhost:50051
# PROJECTS_SERVICE_GRPC_ADDRESS=localhost:50052
# PROJECTS_GRPC_ADDRESS=localhost:50052
# ORCHESTRATOR_BASE_URL=http://localhost:8081
# AI_SERVICE_GRPC_ADDRESS=localhost:50053
# ANALYTICS_SERVICE_GRPC_ADDRESS=localhost:50054
# CLICKHOUSE_ADDR=localhost:9000

# --- Prod Vault AppRole (no VAULT_TOKEN; policies in docker/vault/policies/) ---
# VAULT_ADDR=https://vault.example.com
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

LOG_LEVEL=info
